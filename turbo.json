{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@lifesolver/backend#build": {
      "cache": true,
      "outputs": []
    },
    "lint": {},
    "check": {
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
