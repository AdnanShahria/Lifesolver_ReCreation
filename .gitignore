# ==============================================================================
# LifeSolver Monorepo — Production .gitignore
# ==============================================================================

# ── Dependencies & Package Managers ──────────────────────────────────────────
node_modules/
.pnpm-store/
.npm/
.yarn/

# ── Build Outputs & Compilers ────────────────────────────────────────────────
dist/
build/
out/
.output/
.turbo/
*.tsbuildinfo
.rollup.cache/

# ── Cloudflare Workers, Pages & Local Emulators ──────────────────────────────
.wrangler/
.mf/
worker/dist/

# ── Secrets, Credentials & Local Environment Files ───────────────────────────
# Block all real env and secrets by default
.env
.env.*
.env.local
.env.*.local
.dev.vars
.dev.vars.*
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.kdbx
credentials.json
service-account*.json

# Explicitly whitelist example / template configuration files
!.env.example
!.env.*.example
!.dev.vars.example

# ── Local SQLite & Databases ─────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
dev.db
local.db

# ── Testing, Coverage & Reports ──────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor & Operating System Artifacts ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
*.bak
*.tmp

# IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Flutter & Mobile Native ──────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.ephemeral/
ios/Flutter/Generated.xcconfig
android/local.properties
android/.gradle
android/captures/
ios/Pods/
ios/.symlinks/
